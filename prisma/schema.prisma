generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  phone           String?
  routeTag        String?
  customerType    String           @default("RETAIL")
  current_balance Int              @default(0)
  kpayAliases     KpayAlias[]
  ledgers         Ledger[]
  suggestedKpay   UnverifiedKpay[] @relation("KpaySuggestion")
  orders          Order[]
  cashSales       CashSale[]
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?
}

model Order {
  id                     String          @id @default(uuid()) @db.Uuid
  status                 String          @default("DRAFT")
  requestedDate          String          @default("")
  sourceChatId           String?
  sourceMessageId        String?
  sourceUpdateId         String?
  telegramDraftChatId    String?
  telegramDraftMessageId String?
  sourceText             String          @db.Text
  customerId             String?         @db.Uuid
  customer               Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  draftCustomerName      String?
  draftCustomerPhone     String?
  customerPhone          String?
  missingFields          Json?
  aiConfidence           String?
  aiNotes                String?
  destination            String?
  paymentType            String?
  paymentNote            String?
  receiptNote            String?
  notificationMode       String          @default("IMMEDIATE")
  factoryOrderDate       String?
  factoryOrderNumber     Int?
  confirmedBy            String?
  confirmedAt            DateTime?
  cancelledAt            DateTime?
  cancelledBy            String?
  archivedAt             DateTime?
  archivedBy             String?
  historyTrashedAt       DateTime?
  historyTrashedBy       String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  lines                  OrderLine[]
  caps                   OrderCap[]
  deliveries             OrderDelivery[]

  @@unique([sourceChatId, sourceMessageId])
  @@unique([sourceUpdateId])
  @@unique([factoryOrderDate, factoryOrderNumber])
  @@index([status])
  @@index([requestedDate])
  @@index([factoryOrderDate])
  @@index([archivedAt])
  @@index([historyTrashedAt])
  @@index([cancelledAt])
}

model OrderLine {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @db.Uuid
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNumber     Int
  bottleType     String?
  capacityMl     Int?
  capacityLabel  String?
  bottlesPerCard Int?
  cardCount      Int?
  totalBottles   Int?
  quotedRate     Int?
  quotedAmount   Int?
  notes          String?
  createdAt      DateTime @default(now())

  @@unique([orderId, lineNumber])
  @@index([orderId])
}

model OrderCap {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @db.Uuid
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  capType           String
  normalPcs         Int      @default(0)
  extraPcs          Int      @default(0)
  requestedTotalPcs Int      @default(0)
  expectedPcs       Int?
  warningText       String?
  notes             String?
  createdAt         DateTime @default(now())

  @@unique([orderId, capType])
  @@index([orderId])
}

model OrderDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @db.Uuid
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  destinationType   String
  mode              String
  status            String    @default("PENDING")
  telegramChatId    String?
  telegramMessageId String?
  sentAt            DateTime?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([orderId, destinationType, mode])
  @@index([status])
  @@index([mode])
}

model OrderAutomationSetting {
  id                  Int      @id @default(1)
  morningBatchEnabled Boolean  @default(false)
  morningBatchTime    String   @default("08:10")
  updatedAt           DateTime @updatedAt
}

model OrderBatchRun {
  id           String    @id @default(uuid()) @db.Uuid
  batchDate    String
  status       String    @default("RUNNING")
  orderCount   Int       @default(0)
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())

  @@unique([batchDate])
  @@index([status])
}

model KpayAlias {
  id         String   @id @default(uuid()) @db.Uuid
  kpayName   String   @unique
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Ledger {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String
  saleType    String
  itemSize    String?
  cartons     Int?
  rate        Int?
  deductions  Int      @default(0)
  amount      Int
  note        String?
  paymentType String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([customerId])
  @@index([date])
}

model CashSale {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @db.Uuid
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleType         String   @default("RETAIL")
  itemSize         String?
  cartons          Int?
  rate             Int?
  deductions       Int      @default(0)
  amount           Int
  note             String?
  paymentType      String?
  paymentBreakdown Json?
  date             DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([customerId])
  @@index([date])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorName   String
  action      String
  entityType  String
  entityId    String?
  entityLabel String?
  summary     String
  metadata    Json?
  hiddenAt    DateTime?
  hiddenBy    String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([actorName])
  @@index([action])
  @@index([entityType])
  @@index([hiddenAt])
}

model AiExplanationCache {
  id              String   @id @default(uuid()) @db.Uuid
  reportDate      String
  dataFingerprint String
  promptVersion   String   @default("v2")
  explanation     Json
  generatedBy     String?
  provider        String?
  model           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([reportDate, dataFingerprint, promptVersion])
  @@index([reportDate])
  @@index([reportDate, updatedAt])
}

model AutoReportRun {
  id                    String    @id @default(uuid()) @db.Uuid
  status                String
  trigger               String    @default("schedule")
  reportDate            String?
  periodLabel           String?
  recipientCount        Int       @default(0)
  counts                Json?
  elapsedMs             Int?
  errorMessage          String?
  manualNoticeClaimedAt DateTime?
  manualNoticeSentAt    DateTime?
  createdAt             DateTime  @default(now())

  @@index([createdAt])
  @@index([reportDate])
  @@index([status])
}

model UnverifiedKpay {
  id                  String    @id @default(uuid()) @db.Uuid
  raw_text            String
  kpayName            String?
  amount              Int
  status              String    @default("PENDING")
  suggestedCustomerId String?   @db.Uuid
  suggestedCustomer   Customer? @relation("KpaySuggestion", fields: [suggestedCustomerId], references: [id])
  createdAt           DateTime  @default(now())

  @@index([status])
  @@index([kpayName])
}

model DailySalesSummary {
  id                     String    @id @default(uuid()) @db.Uuid
  date                   String    @unique
  retailTotal            Int       @default(0)
  wholesaleTotal         Int       @default(0)
  retailCash             Int       @default(0)
  wholesaleCash          Int       @default(0)
  source                 String    @default("DAILY_INPUT")
  note                   String?
  enteredAt              DateTime?
  enteredBy              String?
  calculationMode        String?
  sourceSnapshotAt       DateTime?
  sourceTransactionCount Int?
  sourceTransactionTotal Int?
  adjustmentReason       String?
  lastCalculatedAt       DateTime?
  lastCalculatedBy       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([date])
}

model DailySalesSummarySource {
  id               String   @id @default(uuid()) @db.Uuid
  summaryId        String   @db.Uuid
  sourceType       String
  sourceId         String   @db.Uuid
  contributionType String
  amount           Int      @default(0)
  paymentType      String?
  linkedAt         DateTime @default(now())

  @@unique([summaryId, sourceType, sourceId, contributionType])
  @@index([summaryId])
  @@index([sourceType, sourceId])
}

model DailySalesOpening {
  id        String   @id @default(uuid()) @db.Uuid
  month     String   @unique
  amount    Int      @default(0)
  asOfDate  String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month])
}

model ProductionReport {
  id              String   @id @default(uuid()) @db.Uuid
  submissionId    String
  reportDate      String
  actorName       String
  machineCode     String
  machineName     String?
  category        String
  outputQuantity  Int
  outputUnit      String
  outputCapacity  String?
  bottleType      String?
  tubeG           String?
  tubeColor       String?
  wasteQuantity      Int      @default(0)
  wasteNote          String?
  damagedPieces      Int      @default(0)
  tubeDamageQuantity Int      @default(0)
  tubeQuantity       Int      @default(0)
  involvedWorkers    Json?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([reportDate])
  @@index([submissionId])
  @@index([machineCode])
}

model ProductionWorker {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}
